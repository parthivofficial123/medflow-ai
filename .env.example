# Copy to .env (never committed) and fill in. Never commit real values.
# The Flask CLI reads .env; tests never do.

# "json" (default): offline, no sign-in, data in instance/. "supabase": the real database.
MEDFLOW_STORAGE=json
# Required in Supabase mode. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MEDFLOW_SECRET_KEY=

# Supabase mode only (see supabase/README.md). Use the PUBLISHABLE key, never the secret key.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Optional. "1" shows "Reset my demo data" in Supabase mode (always shown in JSON mode).
# Leave it blank for demos and on Vercel, so a demo account can't be reset by accident.
MEDFLOW_DEMO_RESET=

# Bill analysis. Free-tier inputs may be reviewed by Google: fictional bills only.
GEMINI_API_KEY=
# Optional; blank uses the default model (gemini-3.5-flash-lite).
GEMINI_MODEL=
